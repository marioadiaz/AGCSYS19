<tr id="ot_<%= ot.id %>" data-id="<%= ot.id %>" draggable="true">
  <td><%= ot.position %></td>

  <td class="
    <%=
      case ot.priority
      when 'Alta'  then 'bg-danger text-white'
      when 'Media' then 'bg-warning'
      else              'bg-success text-white'
      end
    %>">
    <strong><%= ot.trnum %></strong>
  </td>

  <td><%= link_to ot.clinom, orden_trabajo_path(ot) %></td>

  <td><%= ot.nomprod %></td>
  <td><%= ot.trcan %></td>
  <td><%= ot.papel %></td>
  <td><%= ot.gramaje %></td>
  <td><%= ot.colores %></td>

  <% if lista == "CTP" %>
    <td>
      <%= form_with url: actualizar_campo1_orden_trabajo_path(ot),
                    method: :patch,
                    data: { turbo_stream: true },
                    class: "d-flex" do |f| %>

        <%= f.text_field :campo1,
              value: ot.campo1,
              class: "form-control form-control-sm" %>

        <%= f.submit "💾",
              class: "btn btn-primary btn-sm ms-1" %>

      <% end %>
    </td>
  <% end %>

  <td>
    <%= button_to quitar_lista_orden_trabajo_path(ot),
          method: :patch,
          class: "btn btn-danger btn-sm",
          form: { data: { turbo_stream: true } } do %>
      ❌ Quitar
    <% end %>
  </td>
</tr>