<tr id="<%= dom_id(reg) %>" data-id="<%= reg.id %>">

  <% ot = reg.orden_trabajo %>

  <td class="
    <%= case ot.priority
        when 'Alta'
             'bg-danger text-white'
        when 'Media'
             'bg-warning'
        else
             'bg-success text-white'
        end %>
    fw-bold"> 
    <%= ot.trnum %>
  </td>
  <td>
    <%= link_to ot.clinom,
          orden_trabajo_path(ot),
          class: "text-decoration-none fw-semibold" %>
  </td>
  <td><%= ot.nomprod %></td>
  <td><%= number_with_delimiter(ot.trcan) %></td>
  <td><%= ot.papel %></td>
  <td><%= ot.gramaje %></td>
  <td><%= ot.colores %></td>
  <td><%= reg.estado_interno %></td>
  <% if reg.lista == "Cortadora de Bobinas" %>
    <td><%= reg.observaciones %></td>
  <% elsif ["Laminadora Automática", "Laminadora Manual"].include?(reg.lista) %>
    <td><%= reg.observaciones %></td>
  <% elsif reg.lista == "Tareas Manuales" %>
    <td><%= reg.observaciones %></td>
  <% elsif ["Binder","Encuadernación","Zechini","Horda"].include?(reg.lista) %>
    <td><%= reg.cantidad %></td>
    <td><%= reg.observaciones %></td>
  <% elsif ["Perforadora Manual","Perforadora Automática","Anilladora Automática","Anilladora Manual"].include?(reg.lista) %>
    <td><%= reg.cantidad %></td>        
    <td><%= reg.observaciones %></td>
  <% else %>
    <td><%= reg.observaciones %></td>
  <% end %>

  <td>
    <button
      class="btn btn-primary btn-sm"
      data-bs-toggle="modal"
      data-bs-target="#editarModal_<%= reg.id %>">
      ✏️ Editar
    </button>
  </td>

  <td>
    <%= button_to quitar_lista_orden_trabajo_path(reg),
          method: :delete,
          class: "btn btn-danger btn-sm",
          form: { data: { turbo_stream: true } } do %>
      ❌ Quitar
    <% end %>
  </td>
</tr>