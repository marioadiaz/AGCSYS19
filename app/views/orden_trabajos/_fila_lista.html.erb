<% ot = reg.orden_trabajo %>
<tr id="registro_<%= reg.id %>" data-id="<%= reg.id %>" draggable="true">
  
  <td class="
    <%=
      case reg.orden_trabajo.priority
      when 'Alta'  then 'bg-danger text-white'
      when 'Media' then 'bg-warning'
      else              'bg-success text-white'
      end
    %>">
    <strong><%= ot.trnum %></strong>
  </td>

  <td><%= link_to ot.clinom, orden_trabajo_path(ot) %></td>

  <td><%= ot.nomprod %></td>
  <td><%= ot.trcan %></td>
  <td><%= ot.papel %></td>
  <td><%= ot.gramaje %></td>
  <td><%= ot.colores %></td>
  <td>
    <%= button_to quitar_lista_orden_trabajo_path(reg),
          method: :delete,
          class: "btn btn-danger btn-sm",
          form: { data: { turbo_stream: true } } do %>
      ❌ Quitar
    <% end %>
  </td>
</tr>