<tr id="<%= dom_id(reg) %>" data-id="<%= reg.id %>">

  <% ot = reg.orden_trabajo %>

  <td><%= ot.trnum %></td>
  <td><%= ot.clinom %></td>
  <td><%= ot.nomprod %></td>
  <td><%= number_with_delimiter(ot.trcan) %></td>
  <td><%= ot.papel %></td>
  <td><%= ot.gramaje %></td>
  <td><%= ot.colores %></td>

  <td><%= reg.estado_interno %></td>
  <td><%= reg.observaciones %></td>

  <td>
    <button
      class="btn btn-primary btn-sm"
      data-bs-toggle="modal"
      data-bs-target="#editarModal_<%= reg.id %>">
      ✏️ Editar
    </button>
  </td>

  <td>
    <%= button_to quitar_lista_orden_trabajo_path(reg),
          method: :delete,
          class: "btn btn-danger btn-sm" do %>
      ❌ Quitar
    <% end %>
  </td>

</tr>