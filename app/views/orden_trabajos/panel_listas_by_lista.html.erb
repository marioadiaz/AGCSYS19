    "CTP","Cortadora de Bobinas","Guillotina para Impresión","PM","SM 5 Cuerpos","SM 4 CUERPOS","GTO/QUICK","SORZ","Guillotina p/ Terminación",
    "Digital","Laminadora Automática","Laminadora Manual","Barnizadora","Minerva Grande","Minerva Chica",
    "Plana","Eterna","Tareas Manuales","Dobladora","Horizon","Fidia","Duplo","Binder","Encuadernación","Zechini","Perforadora","Anilladora Automática",
    "Anilladora Manual","Tareas de Mantenimiento"
  ].freeze

CAMPOS_EXTRA = {
        "CTP" => [],
        "Cortadora de Bobinas" => ["Corte", "Medida Y Gramaje", "Marca", "Peso I/Final"],
        "Guillotina para Impresión" => [],
        "PM" => [],
        "SM 5 Cuerpos" => [],
        "SM 4 Cuerpos" => [],
        "GTO/QUICK" => ["Maquina"],
        "SORZ" => [],
        "Guillotina p/ Terminación" => [],
        "Digital" => [],
        "Laminadora Automática" => ["Laminado", "Pliego"],
        "Laminadora Manual"      => ["Laminado", "Pliego"],
        "Barnizadora" => [],
        "Minerva Grande" => ["Tarea", "Cod Troquel"],
        "Minerva Chica"  => ["Tarea", "Cod Troquel"],
        "Plana"          => ["Tarea", "Cod Troquel"],
        "Eterna" => ["Cod Troquel"],
        "Tareas Manuales" => ["Tarea"],
        "Dobladora" => [],
        "Horizon"   => [],
        "Fidia"     => [],        
        "Duplo" => ["Tarea"],
        "Binder" => [],        
        "Encuadernación" => ["Tarea"],
        "Zechini" => [],
        "Perforadora" => ["Proceso", "Maquina"],
        "Anilladora Automática" => [],
        "Anilladora Manual"     => [],
        "Tareas de Mantenimiento" => ["Responsable"]
      }.freeze

<div class="container mt-4">
  <h3 class="text-center">🔀 Órdenes de trabajo por Listas</h3>
  <div data-controller="buscar-ot">
    <div class="row align-items-end mt-3">
      <!-- Dropdown -->
      <div class="col-md-3">
        <%= form_with model: @orden_trabajo, url: orden_trabajos_path, local: true do |f| %>
          <div class="mb-3">
            <%= f.select :lista, @listas, {},
                  class: "form-select",
                  data: { buscar_ot_target: "lista" } %>
          </div>
        <% end %>
      </div>
      <!-- Buscador -->
      <div class="col-md-7">
        <div class="input-group mb-3">
          <input type="text"
                 class="form-control"
                 placeholder="Buscar N° OT o Cliente"
                 data-buscar-ot-target="input">

          <button class="btn btn-primary"
                  type="button"
                  data-action="click->buscar-ot#buscar">
            Buscar
          </button>
        </div>
      </div>
      <!-- Botón PDF -->
      <div class="col-md-2 d-flex justify-content-end mb-3">
        <%= link_to "📄 Descargar PDF",
                panel_listas_pdf_orden_trabajos_path(format: :pdf),
                class: "btn btn-success h-100",
                target: "_blank",
                rel: "noopener" %>
      </div>
    </div>
    <div class="row mt-3">
      <div class="col-12">
        <div id="resultados_busqueda"
             data-buscar-ot-target="resultados">
        </div>
      </div>
    </div>
    <!-- ⭐ FILA 3: TABLAS DE LISTAS (Aquí va tu bloque) -->
    <div class="p-2 border rounded shadow-sm">
      <div class="col-12">
        <% OrdenTrabajo::LIST.each do |lista| %>
          <h3 class="text-center mb-2 bg-primary text-white rounded"><%= lista %></h3>
          <table class="table table-striped table-hover text-center align-middle">
            <thead class="table-dark">
              <tr>
                <th>Posición</th>
                <th>N° OT</th>
                <th>Cliente</th>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Papel</th>
                <th>Gramaje</th>
                <th>Color</th>
                <% if lista == "CTP" %>
                  <th>Fecha</th>
                <% end %>
                <% if lista == "Cortadora de Bobinas" %>
                  <th>Fecha</th>
                  <th>Corte</th>
                  <th>Medida Y Gramaje</th>
                  <th>Marca</th>
                  <th>Peso I/Final</th>
                <% end %>
                <th></th>
                <th></th>
              </tr>
            </thead>
            <tbody
              id="tabla_lista_<%= lista.parameterize(separator: '_') %>"
              data-controller="sortable"
              data-sortable-target="tbody"
              data-sortable-url-value="<%= ordenar_lista_orden_trabajos_path(lista: lista) %>"
            >
              <% @ordenes_por_lista[lista].to_a.each do |ot| %>
                <tr id="ot_<%= ot.id %>" data-id="<%= ot.id %>" draggable="true">
                  <td><%= ot.position %></td>
                  <td class="
                    <%=
                      case ot.priority
                      when 'Alta'  then 'bg-danger text-white'
                      when 'Media' then 'bg-warning'
                      else              'bg-success text-white'
                      end
                    %>">
                    <strong><%= ot.trnum %></strong>
                  </td>
                  <td><%= link_to ot.clinom, orden_trabajo_path(ot) %></td>
                  <td><%= ot.nomprod %></td>
                  <td><%= ot.trcan %></td>
                  <td><%= ot.papel %></td>
                  <td><%= ot.gramaje %></td>
                  <td><%= ot.colores %></td>
                  <% if lista == "CTP" %>
                    <td colspan="5">
                      <%= simple_form_for ot,
                            url: actualizar_campos_orden_trabajo_path(ot),
                            method: :patch,
                            data: { turbo_stream: true },
                            html: { class: "d-flex gap-2 align-items-center" } do |f| %>

                        <%= f.input :fecha_jt, as: :date, html5: true, label: false, input_html: { class: "form-control form-control-sm w-auto", value: f.object.fecha_jt} %>
                        <%= f.button :submit, "💾", class: "btn btn-success btn-sm" %>
                      <% end %>
                    </td>
                  <% end %>
                  <% if lista == "Cortadora de Bobinas" %>
                    <td colspan="5">
                      <%= simple_form_for ot,
                            url: actualizar_campos_orden_trabajo_path(ot),
                            method: :patch,
                            data: { turbo_stream: true },
                            html: { class: "d-flex gap-2 align-items-center" } do |f| %>

                        <%= f.input :fecha_jt, as: :date, html5: true, label: false, input_html: { class: "form-control form-control-sm w-auto", value: f.object.fecha_jt} %>
                        <%= f.input :campo1, input_html: { class: "form-control form-control-sm w-auto" }, label: false, placeholder: "Corte" %>
                        <%= f.input :campo2, input_html: { class: "form-control form-control-sm w-auto" }, label: false, placeholder: "Medida y Gramaje" %>
                        <%= f.input :campo3, input_html: { class: "form-control form-control-sm w-auto" }, label: false, placeholder: "Marca" %>
                        <%= f.input :campo3, input_html: { class: "form-control form-control-sm w-auto" }, label: false, placeholder: "Peso I/Final" %>
                        <%= f.button :submit, "💾", class: "btn btn-success btn-sm" %>
                      <% end %>
                    </td>
                  <% end %>
                  <td>
                    <%= button_to quitar_lista_orden_trabajo_path(ot),
                          method: :patch,
                          class: "btn btn-danger btn-sm w-auto",
                          form: { data: { turbo_stream: true } } do %>
                      ❌
                    <% end %>
                  </td>
                </tr>
              <% end %>

            </tbody>

          </table>
        <% end %>
      </div>
    </div>
  </div>
</div>
