<div class="container-fluid px-4 mt-4">

  <h3 class="text-center mb-4">
    🔀 Órdenes de trabajo por Listas
  </h3>

  <!-- ===================================== -->
  <!-- BUSCADOR + SELECT LISTA + PDF -->
  <!-- ===================================== -->

  <div data-controller="buscar-ot">

    <div class="row align-items-end g-2">

      <!-- SELECT LISTA -->
      <div class="col-md-3">

        <label class="form-label fw-bold">
          Lista destino
        </label>

        <select
          class="form-select"
          data-buscar-ot-target="lista">

          <% @listas.each do |lista| %>
            <option value="<%= lista %>">
              <%= lista %>
            </option>
          <% end %>

        </select>
      </div>

      <!-- BUSCADOR -->
      <div class="col-md-7">

        <label class="form-label fw-bold">
          Buscar Orden
        </label>

        <div class="input-group">

          <input
            type="text"
            placeholder="Buscar N° OT o Cliente"
            class="form-control"
            data-buscar-ot-target="input">

          <button
            class="btn btn-primary"
            type="button"
            data-action="click->buscar-ot#buscar">

            🔎 Buscar

          </button>

        </div>
      </div>

      <!-- PDF -->
      <div class="col-md-2">

        <label class="form-label d-block">
          &nbsp;
        </label>

        <%= link_to "📄 Descargar PDF",
              panel_listas_pdf_orden_trabajos_path(format: :pdf),
              class: "btn btn-success w-100",
              target: "_blank",
              rel: "noopener" %>

      </div>

    </div>

    <!-- RESULTADOS -->
    <div
      id="resultados_busqueda"
      class="mt-4"
      data-buscar-ot-target="resultados">
    </div>

  </div>

  <!-- ===================================== -->
  <!-- TABLAS POR LISTA -->
  <!-- ===================================== -->

  <div class="border rounded shadow-sm p-3 mt-4 bg-white">

    <% @listas.each do |lista| %>

      <% registros = @registros_por_lista[lista] || [] %>

      <div class="mb-5">

        <!-- TITULO LISTA -->

        <h4 class="text-center bg-primary text-white p-2 rounded mb-3">
          <%= lista %>
        </h4>

        <div class="table-responsive">

          <table class="table table-striped table-hover table-bordered align-middle text-center">

            <thead class="table-dark">

              <tr>
                <th>N° OT</th>
                <th>Cliente</th>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Papel</th>
                <th>Gramaje</th>
                <th>Color</th>
                <th>Estado</th>
                <th>Observaciones</th>
                <th width="90">Acciones</th>
              </tr>

            </thead>

            <tbody
              id="tabla_lista_<%= lista.parameterize(separator: '_') %>"
              data-controller="sortable"
              data-sortable-target="tbody"
              data-sortable-url-value="<%= ordenar_lista_orden_trabajos_path(lista: lista) %>">

              <% registros.each do |reg| %>

                <% ot = reg.orden_trabajo %>

                <tr
                  id="registro_<%= reg.id %>"
                  data-id="<%= reg.id %>">

                  <!-- OT -->

                  <td class="
                    <%= case ot.priority
                        when 'Alta'
                          'bg-danger text-white'
                        when 'Media'
                          'bg-warning'
                        else
                          'bg-success text-white'
                        end %>
                    fw-bold
                  ">
                    <%= ot.trnum %>
                  </td>

                  <!-- CLIENTE -->

                  <td>
                    <%= link_to ot.clinom,
                          orden_trabajo_path(ot),
                          class: "text-decoration-none fw-semibold" %>
                  </td>

                  <!-- PRODUCTO -->

                  <td>
                    <%= ot.nomprod %>
                  </td>

                  <!-- CANTIDAD -->

                  <td>
                    <%= number_with_delimiter(ot.trcan) %>
                  </td>

                  <!-- PAPEL -->

                  <td>
                    <%= ot.papel %>
                  </td>

                  <!-- GRAMAJE -->

                  <td>
                    <%= ot.gramaje %>
                  </td>

                  <!-- COLOR -->

                  <td>
                    <%= ot.colores %>
                  </td>

                  <td>
                    <%= form_with scope: :orden_trabajo_listas,
                                  url: actualizar_campos_orden_trabajo_path(reg),
                                  method: :patch,
                                  local: false do |f| %>

                      <%= f.text_field :estado_interno,
                            value: reg.estado_interno,
                            class: "form-control form-control-sm" %>
                      <%= f.submit "💾", class: "btn btn-sm btn-primary mt-1" %>        
                    <% end %>
                  </td>

                  <td>
                    <%= form_with scope: :orden_trabajo_listas,
                                  url: actualizar_campos_orden_trabajo_path(reg),
                                  method: :patch,
                                  local: false do |f| %>

                      <%= f.text_area :observaciones,
                            value: reg.observaciones,
                            rows: 2,
                            class: "form-control form-control-sm" %>
                      <%= f.submit "💾", class: "btn btn-sm btn-primary mt-1" %>        
                    <% end %>
                  </td>

                  <!-- ACCIONES -->

                  <td>              
                    <%= button_to quitar_lista_orden_trabajo_path(reg),
                          method: :delete,
                          class: "btn btn-danger btn-sm",
                          form: { data: { turbo_stream: true } } do %>
                      ❌ Quitar
                    <% end %>
                  </td>

                </tr>

              <% end %>

            </tbody>

          </table>

        </div>

      </div>

    <% end %>

  </div>

</div>