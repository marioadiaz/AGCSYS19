<div class="container-fluid px-5 mt-4">

  <h3 class="text-center mb-4">🔀 Órdenes de trabajo por Listas</h3>

  <!-- ===================================== -->
  <!-- BUSCADOR + SELECT LISTA + BOTÓN PDF -->
  <!-- ===================================== -->
  <div data-controller="buscar-ot">
    <div class="row align-items-end">

      <!-- SELECT LISTA -->
      <div class="col-md-3">
        <%= form_with url: asignar_lista_orden_trabajo_path(1934),
                      method: :patch,
                      local: true do |f| %>

        <%= f.select :lista, @listas, {}, class: "form-select", data: {"buscar-ot-target": "lista"} %>

        <% end %>
      </div>

      <!-- BUSCADOR -->
      <div class="col-md-7">
        <div class="input-group">
          <input type="text"
                 placeholder="Buscar N° OT o Cliente"
                 class="form-control"
                 data-buscar-ot-target="input">

          <button class="btn btn-primary"
                  type="button"
                  data-action="click->buscar-ot#buscar">
            Buscar
          </button>
        </div>
      </div>

      <!-- PDF -->
      <div class="col-md-2 d-flex justify-content-end">
        <%= link_to "📄 Descargar PDF",
              panel_listas_pdf_orden_trabajos_path(format: :pdf),
              class: "btn btn-success w-100",
              target: "_blank" %>
      </div>
    </div>

    <div id="resultados_busqueda" class="mt-3"
       data-buscar-ot-target="resultados"></div>
  </div>


  <!-- ===================================== -->
  <!-- TABLAS POR LISTA -->
  <!-- ===================================== -->
  <div class="border rounded p-3 shadow-sm mt-4">

    <% @listas.each do |lista| %>
      <% registros = @registros_por_lista[lista] || [] %>

      <h3 class="text-center bg-primary text-white p-2 rounded mt-3"><%= lista %></h3>

      <table class="table table-striped table-hover text-center align-middle">
        <thead class="table-dark">
          <tr>
            <th>N° OT</th>
            <th>Cliente</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Papel</th>
            <th>Gramaje</th>
            <th>Color</th>        
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody
              id="tabla_lista_<%= lista.parameterize(separator: '_') %>"
              data-controller="sortable"
              data-sortable-target="tbody"
              data-sortable-url-value="<%= ordenar_lista_orden_trabajos_path(lista: lista) %>"
            >
          <% registros.each do |reg| %>
            <% ot = reg.orden_trabajo %>
            <tr id="registro_<%= reg.id %>" data-id="<%= reg.id %>">
              <!-- CAMPOS DE ORDEN_TRABAJO -->
              <td class="<%= ot.priority == 'Alta' ? 'bg-danger text-white' : ot.priority=='Media' ? 'bg-warning' : 'bg-success text-white' %> fw-bold">
                <%= ot.trnum %>
              </td>
              <td><%= link_to ot.clinom, orden_trabajo_path(ot) %></td>
              <td><%= ot.nomprod %></td>
              <td><%= ot.trcan %></td>
              <td><%= ot.papel %></td>
              <td><%= ot.gramaje %></td>
              <td><%= ot.colores %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
