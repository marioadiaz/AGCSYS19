<div class="container-fluid px-2 mt-2">

  <h3 class="text-center mb">
    🔀 Órdenes de trabajo por Listas
  </h3>

  <!-- ===================================== -->
  <!-- BUSCADOR + SELECT LISTA + PDF -->
  <!-- ===================================== -->

  <div data-controller="buscar-ot" class="sticky-top bg-white z py shadow-sm" style="top: 0;">

    <div class="row align-items-end g-2">

      <!-- SELECT LISTA -->
      <div class="col-md-3">

        <label class="form-label fw-bold">
          Lista destino
        </label>

        <select
          class="form-select"
          data-buscar-ot-target="lista">

          <% @listas.each do |lista| %>
            <option value="<%= lista %>">
              <%= lista %>
            </option>
          <% end %>

        </select>
      </div>

      <!-- BUSCADOR -->
      <div class="col-md-5">

        <label class="form-label fw-bold">
          Buscar Orden
        </label>

        <div class="input-group">

          <input
            type="text"
            placeholder="Buscar N° OT o Cliente"
            class="form-control"
            data-buscar-ot-target="input">

          <button
            class="btn btn-primary"
            type="button"
            data-action="click->buscar-ot#buscar">

            🔎 Buscar

          </button>

        </div>
      </div>

      <!-- PDF -->
      <div class="col-md-2">

        <label class="form-label d-block">
          &nbsp;
        </label>

        <%= link_to "📄 Descargar PDF",
              panel_listas_pdf_orden_trabajos_path(format: :pdf),
              class: "btn btn-danger w-100",
              target: "_blank",
              rel: "noopener" %>

      </div>
      <div class="col-md-2">
        <%= link_to '+ Nuevo trabajo', new_orden_trabajo_path, class: 'btn btn-success w-100' %>
      </div>
    </div>

    <!-- AQUI DEBE APARECER EL PARCIAL _resultados.html.erb -->
    
    <div id="resultados_busqueda"
        class="mt-3"
        data-buscar-ot-target="resultados">
    </div>

  </div>

  <!-- ===================================== -->
  <!-- TABLAS POR LISTA -->
  <!-- ===================================== -->

  <div class ="border rounded shadow-sm p-3 mt-4 bg-white">

    <% @listas.each do |lista| %>

      <% registros = @registros_por_lista[lista] || [] %>
      <% campos = OrdenTrabajoLista.campos_editables_para(lista) %>

      <div class="mb-5">

        <h4 class="text-center bg-primary text-white p-2 rounded mb-3">
          <%= lista %>
        </h4>

        <div class="table-responsive">

          <table class="table table-striped table-hover table-bordered align-middle text-center">

            <thead class="table-dark">
              <tr>
                <th>N° OT</th>
                <th>Cliente</th>
                <th>Producto</th>
                <th>Cantidad OT</th>

                <% campos.each do |campo| %>
                  <th><%= campo[:etiqueta] %></th>
                <% end %>

                <th>Guardar</th>
                <th>Acciones</th>
              </tr>
            </thead>

            <tbody
              id="tabla_lista_<%= lista.parameterize(separator: '_') %>"
              data-controller="sortable"
              data-sortable-target="tbody"
              data-sortable-url-value="<%= ordenar_lista_orden_trabajos_path(lista: lista) %>">

              <%= render partial: "orden_trabajos/fila_lista",
                        collection: registros,
                        as: :reg %>

            </tbody>

          </table>

        </div>

      </div>

    <% end %>

  </div>

</div>  
