<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">

  <style>

    body{
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10px;
      color: #222;
      margin: 0;
      padding: 0;
    }

    .page{
      page-break-after: always;
      width: 100%;
    }

    .page:last-child{
      page-break-after: avoid;
    }

    .header{
      border-bottom: 2px solid #000;
      margin-bottom: 15px;
      padding-bottom: 10px;
    }

    .title{
      font-size: 22px;
      font-weight: bold;
      text-align: center;
      margin-bottom: 5px;
    }

    .subtitle{
      text-align: center;
      font-size: 12px;
      color: #555;
    }

    .info{
      margin-top: 10px;
      font-size: 10px;
    }

    .lista-title{
      background: #0d6efd;
      color: white;
      padding: 10px;
      font-size: 18px;
      font-weight: bold;
      text-align: center;
      margin-bottom: 15px;
    }

    table{
      width: 100%;
      border-collapse: collapse;
    }

    thead{
      display: table-header-group;
    }

    th{
      background: #343a40;
      color: white;
      border: 1px solid #999;
      padding: 6px;
      font-size: 10px;
    }

    td{
      border: 1px solid #cfcfcf;
      padding: 5px;
      font-size: 10px;
      vertical-align: middle;
    }

    .text-center{
      text-align: center;
    }

    .priority-alta{
      background: #dc3545;
      color: white;
      font-weight: bold;
    }

    .priority-media{
      background: #ffc107;
      font-weight: bold;
    }

    .priority-baja{
      background: #198754;
      color: white;
      font-weight: bold;
    }

    .footer{
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      text-align: right;
      font-size: 9px;
      color: #666;
    }

    .small{
      font-size: 9px;
    }

  </style>
</head>

<body>

<% @listas.each do |lista| %>

  <% registros = @registros_por_lista[lista] || [] %>

  <% next if registros.empty? %>

  <div class="page">

    <!-- HEADER -->

    <div class="header">

      <div class="title">
        AGCSYS19
      </div>

      <div class="subtitle">
        Panel de Órdenes de Trabajo por Lista
      </div>

      <div class="info">
        Fecha:
        <strong>
          <%= Time.current.strftime("%d/%m/%Y %H:%M") %>
        </strong>
      </div>

    </div>

    <!-- TITULO LISTA -->

    <div class="lista-title">
      LISTA: <%= lista %>
    </div>

    <!-- TABLA -->

    <table>

      <thead>

        <tr>
          <th width="7%">OT</th>
          <th width="20%">Cliente</th>
          <th width="28%">Producto</th>
          <th width="10%">Cantidad</th>
          <th width="15%">Papel</th>
          <th width="8%">Gramaje</th>
          <th width="12%">Color</th>
        </tr>

      </thead>

      <tbody>

        <% registros.each do |reg| %>

          <% ot = reg.orden_trabajo %>

          <tr>

            <!-- OT -->

            <td class="
              text-center
              <%= case ot.priority
                    when 'Alta'
                      'priority-alta'
                    when 'Media'
                      'priority-media'
                    else
                      'priority-baja'
                  end %>
            ">
              <%= ot.trnum %>
            </td>

            <!-- CLIENTE -->

            <td>
              <%= ot.clinom %>
            </td>

            <!-- PRODUCTO -->

            <td>
              <%= ot.nomprod %>
            </td>

            <!-- CANTIDAD -->

            <td class="text-center">
              <%= number_with_delimiter(ot.trcan) %>
            </td>

            <!-- PAPEL -->

            <td>
              <%= ot.papel %>
            </td>

            <!-- GRAMAJE -->

            <td class="text-center">
              <%= ot.gramaje %>
            </td>

            <!-- COLOR -->

            <td>
              <%= ot.colores %>
            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

  </div>

<% end %>

<div class="footer">
  AGCSYS19
</div>

</body>
</html>

