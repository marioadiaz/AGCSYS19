<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">

  <style>

    body{
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10px;
      margin: 0;
      padding: 0;
    }

    .page{
      page-break-after: always;
    }

    .header{
      margin-bottom: 15px;
      padding-bottom: 10px;
    }

    .title{
      font-size: 22px;
      font-weight: bold;
      text-align: center;
      margin-bottom: 5px;
    }

    .subtitle{
      text-align: center;
      font-size: 12px;
      color: #555;
    }

    .info{
      margin-top: 10px;
      font-size: 10px;
    }

    .lista-title{
      background: #0d6efd;
      color: white;
      padding: 8px;
      font-size: 18px;
      font-weight: bold;
      text-align: center;
      margin-bottom: 12px;
    }

    .titulo-lista{
      background: #0d6efd;
      color: white;
      text-align: center;
      padding: 8px;
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 12px;
    }

    table{
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    th{
      background: #212529;
      color: white;
      border: 1px solid #000;
      padding: 4px;
      text-align: center;
      font-size: 10px;
    }

    td{
      border: 1px solid #000;
      padding: 3px;
      text-align: center;
      vertical-align: middle;
      word-wrap: break-word;
      overflow-wrap: break-word;
      height: 50px;
    }

    /* ===================================== */
    /* ANCHO DE COLUMNAS */
    /* ===================================== */

    .col-ot{
      width: 5%;
    }

    .col-cliente{
      width: 20%;
    }

    .col-producto{
      width: 15%;
    }

    .col-cantidad{
      width: 7%;
    }

    .col-papel{
      width: 12%;
    }

    .col-gramaje{
      width: 7%;
    }

    .col-color{
      width: 8%;
    }

    .col-observacion{
      width: 26%;
    }

    /* ===================================== */
    /* PRIORIDADES */
    /* ===================================== */

    .alta{
      background: #dc3545;
      color: white;
      font-weight: bold;
    }

    .media{
      background: #ffc107;
      font-weight: bold;
    }

    .baja{
      background: #198754;
      color: white;
      font-weight: bold;
    }
  </style>
</head>

<body>

<% @listas.each do |lista| %>

  <% registros = @registros_por_lista[lista] || [] %>

  <% next if registros.empty? %>

  <div class="page">

    <!-- HEADER -->

    <div class="header">

      <div class="title">
        AGCSYS19
      </div>

      <div class="subtitle">
        Panel de Órdenes de Trabajo por Lista
      </div>

      <div class="info">
        Fecha:
        <strong>
          <%= Time.current.strftime("%d/%m/%Y %H:%M") %>
        </strong>
      </div>

    </div>

    <!-- TITULO LISTA -->

    <div class="lista-title">
      LISTA: <%= lista %>
    </div>

    <table>

      <thead>
        <tr>
          <th class="col-ot">OT</th>
          <th class="col-cliente">Cliente</th>
          <th class="col-producto">Producto</th>
          <th class="col-cantidad">Cantidad</th>
          <th class="col-papel">Papel</th>
          <th class="col-gramaje">Gramaje</th>
          <th class="col-color">Color</th>
        </tr>
      </thead>

      <tbody>

        <% registros.each do |reg| %>

          <% ot = reg.orden_trabajo %>

          <tr>

            <td class="
              <%=
                case ot.priority
                when 'Alta'
                  'alta'
                when 'Media'
                  'media'
                else
                  'baja'
                end
              %>
            ">
              <%= ot.trnum %>
            </td>

            <td>
              <%= ot.clinom %>
            </td>

            <td>
              <%= ot.nomprod %>
            </td>

            <td>
              <%= number_with_delimiter(ot.trcan) %>
            </td>

            <td>
              <%= ot.papel %>
            </td>

            <td>
              <%= ot.gramaje %>
            </td>

            <td>
              <%= ot.colores %>
            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

  </div>

<% end %>

</body>
</html>