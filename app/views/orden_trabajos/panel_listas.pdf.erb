<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">

    <style>

      body{
        font-family: Arial, Helvetica, sans-serif;
        font-size: 18px;
        margin: 0;
        padding: 0;
      }

      .page{
        page-break-after: always;
      }

      .header{
        margin-bottom: 10px;
        border-bottom: 1px solid #ccc;
        padding-bottom: 5px;
      }

      .header-table{
        width: 100%;
        border-collapse: collapse;
      }

      .header-table td{
        border: none;
        height: auto;
        padding: 0;
        vertical-align: middle;
      }

      .header-left{
        width: 20%;
        text-align: left;
        font-size: 20px;
        font-weight: bold;
      }

      .header-center{
        width: 60%;
        text-align: center;
        font-size: 14px;
        font-weight: bold;
      }

      .header-right{
        width: 20%;
        text-align: right;
        font-size: 10px;
      }

      .title{
        font-size: 22px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 5px;
      }

      .subtitle{
        text-align: center;
        font-size: 12px;
        color: #555;
      }

      .info{
        margin-top: 10px;
        font-size: 10px;
      }

      .lista-title{
        background: #0d6efd;
        color: white;
        padding: 8px;
        font-size: 18px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 12px;
      }

      .titulo-lista{
        background: #0d6efd;
        color: white;
        text-align: center;
        padding: 8px;
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 12px;
      }

      table{
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
      }

      th{
        background: #212529;
        color: white;
        border: 1px solid #000;
        padding: 6px;
        text-align: center;
        vertical-align: top;
        font-size: 1.5rem;
      }

      td{
        border: 1px solid #000;
        padding: 6px;
        vertical-align: top;
        font-size: 1.5rem;
        white-space: normal;
        word-wrap: break-word;
        overflow-wrap: break-word;
        line-height: 1.3;
        height: 2rem;
      }

      /* ===================================== */
      /* ANCHO DE COLUMNAS */
      /* ===================================== */

      .col-ot{
        width: 4%;
        text-align: center !important;
        vertical-align: middle !important;
      }

      .col-cliente{
        width: 15%;
        text-align: center;
      }

      .col-producto{
        width: 10%;
        text-align: center;
      }

      .col-estado_interno{
        width: 5%;
        text-align: center;
      }

      .col-cantidad{
        width: 5%;
        text-align: center;
      }

      .col-observacion{
        width: 26%;   
        text-align: center;
      }

      .col-campos_manuales{
        width: 6%;
        text-align: center;
      }

      /* ===================================== */
      /* PRIORIDADES */
      /* ===================================== */

      .alta{
        background: #dc3545;
        color: white;
        font-weight: bold;
      }

      .media{
        background: #ffc107;
        font-weight: bold;
      }

      .baja{
        background: #198754;
        color: white;
        font-weight: bold;
      }
    </style>
  </head>

  <body>

  <% @listas.each do |lista| %>

    <% registros = @registros_por_lista[lista] || [] %>

    <% next if registros.empty? %>

    <div class="page">

      <!-- HEADER -->

      <div class="header">

        <table class="header-table">
          <tr>

            <td class="header-left">
              <strong>AGCSYS19</strong>
            </td>

            <td class="header-center">
              Órdenes de Trabajo por Lista
            </td>

            <td class="header-right">
              Fecha:
              <strong>
                <%= Time.current.strftime("%d/%m/%Y %H:%M") %>
              </strong>
            </td>

          </tr>
        </table>

      </div>

      <!-- TITULO LISTA -->

      <div class="lista-title">
        LISTA: <%= lista %>
      </div>

      <table>

        <thead>
          <tr>
            <th class="col-ot">OT</th>
            <th class="col-cliente">Cliente</th>
            <th class="col-producto">Producto</th>
            <% if lista == "Cortadora de Bobinas" %>
              <th class="col-campos_manuales">Peso inicial</th>
              <th class="col-campos_manuales">Peso final</th>
              <th class="col-observacion">Cant Pliegos, Corte, Medida. Gramaje, Marca</th>
            <% elsif ["Laminadora Automática","Laminadora Manual"].include?(lista) %>
              <th class="col-observacion">Tipo de laminado / Tamaño de pliego</th>
            <% elsif ["Minerva Grande","Minerva Chica"].include?(lista) %>
              <th class="col-campos_manuales">Troquelado</th>
              <th class="col-campos_manuales">1/2 Corte</th>
              <th class="col-campos_manuales">Stamping</th>
              <th class="col-campos_manuales">Puntillado</th>
              <th class="col-campos_manuales">Relieve</th>
              <th class="col-observacion">Observaciones / Fecha entrega</th>
            <% elsif ["Plana"].include?(lista) %>
              <th class="col-campos_manuales">Troquealdo y/o relieve</th>
              <th class="col-campos_manuales">Hendido</th>
              <th class="col-campos_manuales">Puntillado</th>
              <th class="col-observacion">Observaciones / Fecha entrega</th>
            <% elsif ["Eterna"].include?(lista) %>
              <th class="col-campos_manuales">Troquealdo y/o relieve</th>
              <th class="col-campos_manuales">Hendido</th>
              <th class="col-observacion">Observaciones / Fecha entrega</th>    
            <% elsif lista == "Tareas Manuales" %>
              <th class="col-observacion">Tareas</th>
            <% elsif ["Binder","Encuadernación","Zechini","Horda"].include?(lista) %>
              <th class="col-cantidad">Cantidad</th>
              <th class="col-observacion">Observaciones / Fecha entrega</th>
            <% elsif ["Perforadora Manual","Perforadora Automática"].include?(lista) %>
              <th>Tipo Perforación</th>
            <% else %>
              <th class="col-observacion">Observaciones / Fecha entrega</th>
            <% end %>
          </tr>
        </thead>

        <tbody>

          <% registros.each do |reg| %>

            <% ot = reg.orden_trabajo %>

            <tr>
              <td>
                <%= ot.trnum %>
              </td>
              <td><%= ot.clinom.first(20) %></td>
              <td><%= ot.nomprod.first(20) %></td>
              <% if lista == "Cortadora de Bobinas" %>
                <td></td>
                <td></td>
                <td><%= reg.observaciones %></td>
              <% elsif ["Laminadora Automática", "Laminadora Manual"].include?(lista) %>
                <td><%= reg.observaciones %></td>
              <% elsif ["Minerva Grande","Minerva Chica"].include?(lista) %>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td><%= reg.observaciones %></td>
              <% elsif ["Plana"].include?(lista) %>
                <td></td>
                <td></td>
                <td></td>
                <td><%= reg.observaciones %></td>
              <% elsif ["Eterna"].include?(lista) %>
                <td></td>
                <td></td>
                <td><%= reg.observaciones %></td>
              <% elsif lista == "Tareas Manuales" %>
                <td><%= reg.observaciones %></td>
              <% elsif ["Binder","Encuadernación","Zechini","Horda"].include?(lista) %>
                <td><%= reg.cantidad %></td>
                <td><%= reg.observaciones %></td>
              <% elsif ["Perforadora Manual", "Perforadora Automática"].include?(lista) %>
                <td><%= reg.observaciones %></td>
              <% else %>
                <td><%= reg.observaciones %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  </body>
</html>