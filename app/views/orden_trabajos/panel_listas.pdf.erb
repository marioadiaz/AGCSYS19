```erb
<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">

  <style>
    body{
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11px;
      color: #222;
    }

    h1{
      text-align:center;
      margin-bottom: 25px;
      border-bottom: 2px solid #000;
      padding-bottom: 10px;
    }

    .lista-title{
      background: #0d6efd;
      color: white;
      padding: 8px;
      font-size: 16px;
      font-weight: bold;
      margin-top: 30px;
      margin-bottom: 10px;
      border-radius: 4px;
    }

    table{
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 25px;
    }

    th{
      background: #343a40;
      color: white;
      padding: 6px;
      border: 1px solid #999;
      font-size: 10px;
    }

    td{
      border: 1px solid #cfcfcf;
      padding: 5px;
      font-size: 10px;
    }

    .text-center{
      text-align:center;
    }

    .priority-alta{
      background: #dc3545;
      color: white;
      font-weight: bold;
    }

    .priority-media{
      background: #ffc107;
      font-weight: bold;
    }

    .priority-baja{
      background: #198754;
      color: white;
      font-weight: bold;
    }

    .footer{
      position: fixed;
      bottom: -10px;
      left: 0;
      right: 0;
      text-align: right;
      font-size: 9px;
      color: #666;
    }

    .small{
      font-size: 9px;
    }
  </style>
</head>

<body>

  <h1>
    🔀 Órdenes de Trabajo por Listas
  </h1>

  <p class="small">
    Fecha de impresión:
    <%= Time.current.strftime("%d/%m/%Y %H:%M") %>
  </p>

  <% @listas.each do |lista| %>

    <% registros = @registros_por_lista[lista] || [] %>

    <% next if registros.empty? %>

    <div class="lista-title">
      <%= lista %>
    </div>

    <table>

      <thead>
        <tr>
          <th width="8%">OT</th>
          <th width="20%">Cliente</th>
          <th width="22%">Producto</th>
          <th width="10%">Cantidad</th>
          <th width="15%">Papel</th>
          <th width="10%">Gramaje</th>
          <th width="15%">Color</th>
        </tr>
      </thead>

      <tbody>

        <% registros.each do |reg| %>

          <% ot = reg.orden_trabajo %>

          <tr>

            <td class="
              text-center
              <%= case ot.priority
                    when 'Alta'
                      'priority-alta'
                    when 'Media'
                      'priority-media'
                    else
                      'priority-baja'
                  end %>
            ">
              <%= ot.trnum %>
            </td>

            <td>
              <%= ot.clinom %>
            </td>

            <td>
              <%= ot.nomprod %>
            </td>

            <td class="text-center">
              <%= number_with_delimiter(ot.trcan) %>
            </td>

            <td>
              <%= ot.papel %>
            </td>

            <td class="text-center">
              <%= ot.gramaje %>
            </td>

            <td>
              <%= ot.colores %>
            </td>

          </tr>

        <% end %>

      </tbody>

    </table>

  <% end %>

  <div class="footer">
    AGCSYS19
  </div>

</body>
</html>
```
