<div class="d-flex justify-content-between align-items-center mb-3">

  <%# Contador %>
  <div class="ms-3">
    <h3 class="mb-0">
      Procesos:
      <span id="contador_ordenes"
            class="badge bg-dark">
        <%= @contador %>
      </span>
    </h3>
  </div>

  <%# Buscador %>
  <div class="flex-grow-1 text-center my-2">
    <input
      class="form-control d-inline-block w-50"
      id="buscador_index"
      type="search"
      placeholder="Buscar por OT o cliente..."
      autocomplete="off"
      data-orden-trabajo-target="search"
      data-action="input->orden-trabajo#buscar">
  </div>

  <%# Nuevo trabajo %>
  <div class="me-3 d-none d-sm-block">
    <%= link_to "+ Nuevo trabajo",
                new_orden_trabajo_path,
                class: "btn btn-success btn-lg" %>
  </div>

</div>

<%# Botón volver arriba %>
<button onclick="topFunction()"
        id="myBtn"
        title="Volver arriba"
        class="btn btn-danger shadow fw-bold text-white"
        style="display:none; position:fixed; bottom:40px; right:40px;
               z-index:9999; border-radius:8px; padding:10px 20px;
               font-size:16px;">
  Tira Mi Su
</button>

<%# Contenedor Stimulus %>
<div
  data-controller="orden-trabajo"
  data-orden-trabajo-search-url-value="<%= buscar_orden_trabajos_path(format: :json) %>"
  data-orden-trabajo-load-url-value="<%= cargar_mas_orden_trabajos_path(format: :json) %>"
  data-orden-trabajo-next-cursor-value="<%= @next_cursor %>"
  data-orden-trabajo-has-more-value="<%= @has_more %>">

  <%# Formularios externos a la tabla %>
  <div id="orden_trabajo_forms"
       class="d-none"
       data-orden-trabajo-target="forms">

    <%= render partial: "orden_trabajo_form",
               collection: @orden_trabajos,
               as: :orden_trabajo %>

  </div>

  <%# Tabla %>
  <div class="table-responsive">

    <table id="TablaOrdenesTrabajos"
           class="table table-striped table-hover align-middle text-center">

      <thead class="table-dark">
        <tr>
          <th>OT</th>
          <th>Cliente</th>
          <th>Producto</th>
          <th>Cantidad</th>
          <th>Estado actual</th>
          <th>Proceso</th>
          <th>Fecha entrega</th>
          <th>Prioridad</th>
          <th>Observaciones</th>
          <th></th>
          <th></th>
        </tr>
      </thead>

      <tbody id="orden_trabajos_body"
             data-orden-trabajo-target="rows">

        <%= render partial: "orden_trabajo_row",
                   collection: @orden_trabajos,
                   as: :orden_trabajo %>

      </tbody>

    </table>

  </div>

  <%# Indicador de carga %>
  <div id="estado_carga"
       class="text-center py-3"
       data-orden-trabajo-target="status">
    <span class="text-muted">Desplazate hacia abajo para cargar más órdenes.</span>
  </div>

  <%# Elemento observado por IntersectionObserver %>
  <div id="cargar_mas_trigger"
       style="height: 20px;"
       data-orden-trabajo-target="sentinel">
  </div>

</div>