<div class="modal fade"
     id="editarModal_<%= reg.id %>"
     tabindex="-1">

  <div class="modal-dialog modal-lg">
    <div class="modal-content">

      <% ot = reg.orden_trabajo %>

      <div class="modal-header">
        <h5 class="modal-title">
          OT <%= ot.trnum %> - <%= ot.clinom %>
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>
      </div>

      <%= form_with scope: :orden_trabajo_listas,
              url: actualizar_campos_orden_trabajo_path(reg),
              method: :patch,
              data: { turbo: true } do |f| %>

        <div class="modal-body">

          <%= f.select :estado_interno,
                ["En Espera",
                 "En Proceso",
                 "Completado",
                 "Detenido"],
                { selected: reg.estado_interno },
                class: "form-select mb-3" %>

          <%= f.text_area :observaciones,
                value: reg.observaciones,
                rows: 6,
                class: "form-control" %>

        </div>

        <div class="modal-footer">

          <button type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal">
            Cancelar
          </button>

          <%= f.submit "Guardar cambios",
                class: "btn btn-success" %>

        </div>

      <% end %>

    </div>
  </div>
</div>