<div class="modal fade"
     id="editarModal_<%= reg.id %>"
     tabindex="-1">

  <div class="modal-dialog modal-lg">
    <div class="modal-content">

      <% ot = reg.orden_trabajo %>

      <div class="modal-header">
        <h5 class="modal-title">
          OT <%= ot.trnum %> - <%= ot.clinom %>
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>
      </div>

      <%= form_with scope: :orden_trabajo_listas,
                    url: actualizar_campos_orden_trabajo_path(reg),
                    method: :patch,
                    data: { turbo: true } do |f| %>

        <div class="modal-body">

          <!-- Estado -->
          <div class="mb-3">
            <%= f.label :estado_interno, "Estado", class: "form-label fw-bold" %>

            <%= f.select :estado_interno,
                  ["En Espera",
                   "En Proceso",
                   "Completado",
                   "Detenido"],
                  { selected: reg.estado_interno },
                  class: "form-select" %>
          </div>

          <% if reg.lista == "Cortadora de Bobinas" %>

            <%= f.text_area :observaciones,
                  value: reg.observaciones,
                  placeholder: "Cant. Pliegos, Corte, Medida, Gramaje, Marca",
                  rows: 5,
                  class: "form-control" %>

          <% elsif ["Laminadora Automática", "Laminadora Manual"].include?(reg.lista) %>

            <%= f.text_area :observaciones,
                  value: reg.observaciones,
                  placeholder: "Tipo de laminado / Tamaño de pliego",
                  rows: 5,
                  class: "form-control" %>

          <% elsif reg.lista == "Tareas Manuales" %>

            <%= f.text_area :observaciones,
                  value: reg.observaciones,
                  placeholder: "Tareas realizadas",
                  rows: 5,
                  class: "form-control" %>
          <% elsif ["Binder","Encuadernación","Zechini","Horda"].include?(reg.lista) %>

            <div class="row">

              <div class="col-md-4">
                <%= f.number_field :cantidad,
                      value: reg.cantidad,
                      placeholder: "Cantidad",
                      class: "form-control" %>
              </div>

            </div>
                    
          <% elsif ["Perforadora Manual", "Perforadora Automática"].include?(reg.lista) %>

            <div class="row">

              <div class="col-md-4">
                <%= f.number_field :cantidad,
                      value: reg.cantidad,
                      placeholder: "Cantidad",
                      class: "form-control" %>
              </div>

              <div class="col-md-8">
                <%= f.text_area :observaciones,
                      value: reg.observaciones,
                      placeholder: "Tipo de perforación",
                      rows: 3,
                      class: "form-control" %>
              </div>

            </div>

          <% else %>

            <%= f.text_area :observaciones,
                  value: reg.observaciones,
                  placeholder: "Observaciones / Fecha de entrega",
                  rows: 5,
                  class: "form-control" %>

          <% end %>

        </div>

        <div class="modal-footer">

          <button type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal">
            Cancelar
          </button>

          <%= f.submit "Guardar cambios",
                class: "btn btn-success" %>

        </div>

      <% end %>

    </div>
  </div>

</div>